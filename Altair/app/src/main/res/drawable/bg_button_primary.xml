<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <corners android:radius="16dp" />
            <gradient
                android:startColor="#1677FF"
                android:endColor="#28B8E8"
                android:angle="0" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="16dp" />
            <gradient
                android:startColor="@color/altair_primary_dark"
                android:endColor="@color/altair_primary"
                android:angle="0" />
        </shape>
    </item>

</selector>