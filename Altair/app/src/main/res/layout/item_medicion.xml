<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:cardUseCompatPadding="true"
    app:cardBackgroundColor="@color/altair_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_altair"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtFila1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="08:31:22  |  -95 dBm RSRP"
                android:textColor="@color/altair_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:paddingHorizontal="11dp"
                android:paddingVertical="6dp"
                android:text="4G"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/altair_primary"
                android:background="@drawable/bg_chip_altair" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/altair_divider" />

        <TextView
            android:id="@+id/txtFila2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-16.39209, -71.50897  |  PCI 123  |  Band B28"
            android:textColor="@color/altair_text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>