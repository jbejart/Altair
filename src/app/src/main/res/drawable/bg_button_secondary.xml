<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#243A5C" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/altair_primary" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="@color/altair_surface_2" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/altair_stroke" />
        </shape>
    </item>

</selector>