<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootOnboardingPage"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="12dp"
    android:paddingVertical="24dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card_glass"
        android:padding="26dp">

        <ImageView
            android:id="@+id/imgIllustration"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:src="@drawable/altair_logo"
            android:contentDescription="Illustration"
            android:layout_marginBottom="28dp" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Coverage monitoring"
            android:textColor="@color/altair_text"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Altair measures signal power, radio quality, and GPS location to build real mobile coverage maps."
            android:textColor="@color/altair_text_secondary"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="5dp" />

        <CheckBox
            android:id="@+id/chkTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I accept the terms and authorize the use of technical data"
            android:textColor="@color/altair_text_secondary"
            android:textSize="13sp"
            android:buttonTint="@color/altair_primary"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>